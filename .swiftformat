--swiftversion 6.2
--indent 2
--tabwidth 2
--wraparguments before-first
--wrapcollections before-first
--wrapconditions after-first
--exclude .build
--exclude .swiftpm
--exclude interfaces
# Generated by swift-openapi-generator (deno task generate-openapi). The files
# also carry a `// swiftformat:disable all` directive; excluding the package
# keeps the checked-in output byte-identical to what the generator emits.
--exclude packages/wuhu-contract/Targets
# Golden fixtures for the alignment renderer; bytes must match renderer output.
--exclude packages/alignment/Targets/AlignmentKit/Tests/fixtures

# Allowlist: SwiftFormat is configured to be a *formatter*, not a code
# rewriter. Only rules that touch layout, whitespace, and import order are
# enabled. Anything that rewrites code shape, removes redundant-looking
# constructs, or makes opinionated stylistic edits is intentionally off.
#
# If you want to add a rule here, run it in --lint mode against the repo
# first and review the diff — the bar is "this is mechanical formatting,
# not a refactor".
--rules blankLineAfterImports,blankLinesAroundMark,blankLinesAtEndOfScope,blankLinesAtStartOfScope,blankLinesBetweenChainedFunctions,blankLinesBetweenImports,blankLinesBetweenScopes,braces,consecutiveBlankLines,consecutiveSpaces,consistentSwitchCaseSpacing,duplicateImports,elseOnSameLine,emptyBraces,fileMacro,headerFileName,indent,leadingDelimiters,linebreakAtEndOfFile,linebreaks,modifiersOnSameLine,numberFormatting,semicolons,sortImports,spaceAroundBraces,spaceAroundBrackets,spaceAroundComments,spaceAroundGenerics,spaceAroundOperators,spaceAroundParens,spaceInsideBraces,spaceInsideBrackets,spaceInsideComments,spaceInsideGenerics,spaceInsideParens,trailingCommas,trailingSpace,wrap,wrapArguments,wrapAttributes,wrapMultilineStatementBraces
