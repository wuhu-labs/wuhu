#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
real="${BAZEL_REAL:-}"

if [[ -z "$real" ]]; then
  echo "tools/bazel is a Bazelisk workspace wrapper; BAZEL_REAL is unset" >&2
  exit 2
fi

if [[ "${WUHU_POOL:-}" != "0" && ( "${WUHU_POOL:-}" == "1" || "${WUHU_LINUX_POOL:-}" == "1" || -n "${WUHU_POOL_URL:-}" ) ]]; then
  if deno run --allow-read="$repo" --allow-env=WUHU_POOL,WUHU_LINUX_POOL,WUHU_POOL_URL,WUHU_POOL_TOKEN_FILE --allow-sys=systemMemoryInfo --allow-run "$repo/tools/check/pool-route.ts" --probe "$@"; then
    exec deno run --allow-read="$repo" --allow-env=WUHU_POOL,WUHU_LINUX_POOL,WUHU_POOL_URL,WUHU_POOL_TOKEN_FILE --allow-sys=systemMemoryInfo --allow-run "$repo/tools/check/pool-route.ts" "$@"
  fi
fi
args=()
for arg in "$@"; do
  if [[ "$arg" != "--local" ]]; then args+=("$arg"); fi
done
set -- ${args[@]+"${args[@]}"}

stamp="$repo/.wuhu/manifest-stamp"
outputs="$repo/.wuhu/manifest-outputs"
provenance="$repo/.wuhu/manifest-provenance"
lock="$repo/.wuhu/manifest-lock"
lock_held=0

release_lock() {
  if [[ "$lock_held" == "1" ]]; then
    rm -f "$lock/pid"
    rmdir "$lock" 2>/dev/null || true
    lock_held=0
  fi
}

acquire_lock() {
  while ! mkdir "$lock" 2>/dev/null; do
    if owner="$(cat "$lock/pid" 2>/dev/null)"; then
      if [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
        stale="$lock.stale.$$"
        if mv "$lock" "$stale" 2>/dev/null; then
          rm -rf "$stale"
        fi
      fi
    fi
    sleep 0.05
  done
  printf '%s\n' "$$" >"$lock/pid"
  lock_held=1
}

generated_output_missing() {
  [[ -s "$outputs" ]] || return 0
  while IFS= read -r output; do
    [[ -n "$output" && -e "$repo/$output" ]] || return 0
  done <"$outputs"
  while IFS= read -r manifest; do
    [[ -e "${manifest%/package.yml}/BUILD.bazel" ]] || return 0
  done < <(find "$repo/packages" -mindepth 2 -maxdepth 2 -name package.yml -type f)
  return 1
}

manifests_stale() {
  [[ -e "$stamp" ]] || return 0
  [[ -s "$provenance" ]] || return 0
  generated_output_missing && return 0
  snapshot="$(
    cd "$repo"
    deno run --quiet --allow-read tools/manifest-gen/provenance.ts \
      --newer-than "$stamp"
  )"
  current="${snapshot%%$'\n'*}"
  freshness="${snapshot#*$'\n'}"
  recorded="$(<"$provenance")"
  [[ "$current" != "$recorded" || "$freshness" == "newer" ]]
}

if [[ "${WUHU_BAZEL_RAW:-0}" != "1" ]]; then
  mkdir -p "$(dirname "$stamp")"
  if manifests_stale; then
    acquire_lock
    trap release_lock EXIT HUP INT TERM
    if manifests_stale; then
      (cd "$repo" && deno task generate-manifests) >&2
      if manifests_stale; then
        echo "manifest generation did not publish current provenance" >&2
        exit 1
      fi
    fi
    release_lock
    trap - EXIT HUP INT TERM
  fi
fi

startup=()
if [[ "${1:-}" != "--version" ]]; then
  if [[ -n "${WUHU_BAZEL_OUTPUT_BASE:-}" ]]; then startup+=("--output_base=$WUHU_BAZEL_OUTPUT_BASE"); fi
  if [[ -n "${WUHU_POOL_BAZELRC:-}" ]]; then startup+=("--bazelrc=$WUHU_POOL_BAZELRC"); fi
fi
if [[ -n "${WUHU_POOL_BEP:-}" && ( "${1:-}" == "build" || "${1:-}" == "test" ) ]]; then
  verb="$1"
  shift
  exec "$real" ${startup[@]+"${startup[@]}"} "$verb" "--build_event_json_file=$WUHU_POOL_BEP" --build_event_publish_all_actions "--execution_log_json_file=$WUHU_POOL_EXECUTION_LOG" "$@"
fi
exec "$real" ${startup[@]+"${startup[@]}"} "$@"
