# The Linux static binary can only drop full Foundation + ICU (~30MB) once no
# object references a full-Foundation-only symbol (see #1253/#1270). These
# patches clear the remaining third-party roots off-Darwin without changing
# Darwin behavior: here, swift-clocks' NSLock/NSRecursiveLock become a pthread
# shim (swiftpkg_swift_concurrency_extras and swiftpkg_xctest_dynamic_overlay
# carry the rest). swift-configuration's default `JSON` trait
# (JSONSerialization/NSNull) needs no config at all: async-http-client, its
# only dependent, requests `traits: []`, and the rspm fork honors that.
swift_deps.configure_package(
    name = "swiftpkg_swift_clocks",
    patch_args = ["-p1"],
    patches = ["//bazel/patches:swift-clocks-linux-lock.patch"],
)
