load(":defs.bzl", "swiftlint_test")

# SwiftLint compiles these into its SwiftLintExtraRules module (MODULE.bazel.template).
exports_files(["ExtraRules.swift"])

swiftlint_test(
    name = "violations_test",
    srcs = ["testdata/Sources/Violations.swift"],
    expected_violations = [
        "duplicate_conditions",
        "no_nslock",
        "no_jsonserialization",
        "no_task_sleep",
        "no_combine_import",
        "no_unchecked_sendable",
        "no_observable_object",
        "superfluous_disable_command",
        "testable_import_outside_tests",
