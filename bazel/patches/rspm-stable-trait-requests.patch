 # MARK: - swift_deps bzlmod Extension
 
 _DO_WHILE_RANGE = range(1000)
+
+
+def _trait_request_key(request):
+    return (request["name"], json.encode(request))
+
+def canonical_trait_requests(requests):
+    """Canonicalize SwiftPM trait Sets before recording repository attributes."""
+    if requests == None:
+        return None
+    result = []
+    for request in requests:
+        canonical = {key: request[key] for key in sorted(request.keys())}
+        condition = canonical.get("condition")
+        if condition:
+            canonical["condition"] = {
+                key: sorted(condition[key]) if key == "traits" else condition[key]
+                for key in sorted(condition.keys())
+            }
+        result.append(canonical)
+    return sorted(result, key = _trait_request_key)
 
