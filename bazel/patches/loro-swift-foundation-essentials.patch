diff --git a/Sources/Loro/UniffiLock.swift b/Sources/Loro/UniffiLock.swift
new file mode 100644
index 0000000..7ba0995
--- /dev/null
+++ b/Sources/Loro/UniffiLock.swift
@@ -0,0 +1,9 @@
+import Synchronization
+
+final class UniffiLock: Sendable {
+    private let mutex = Mutex(())
+
+    func withLock<T, E: Error>(f: () throws(E) -> T) throws(E) -> T {
+        try mutex.withLock { _ throws(E) in try f() }
+    }
+}
