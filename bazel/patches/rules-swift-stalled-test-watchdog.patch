+/// Names the tests that have been running for longer than a limit, on standard error, while the
+/// run is still in progress.
+///
+/// The console recorder runs quiet, so it prints no started or passed lines, and the xUnit records
+/// are written only after the run ends. When a test hangs and Bazel kills the process at its
+/// timeout, this is the only place the hung test is named.
+private final class StalledTestWatchdog: Sendable {
+  private struct Running: Sendable {
+    var startedAt: ContinuousClock.Instant
+    var reported: Bool
+  }
+
+  /// How long a test runs before it is named.
+  private static let limit: Swift.Duration = .seconds(60)
+
+  /// How often the running tests are checked against the limit.
+  private static let interval: Swift.Duration = .seconds(5)
+
+  private let isSuite: @Sendable (String) -> Bool
+  private let running = Locked<[String: Running]>([:])
+  private let stopped = Locked(false)
+
+  init(isSuite: @escaping @Sendable (String) -> Bool) {
+    self.isSuite = isSuite
+  }
+
+  /// Tracks the tests that started and have not yet ended from one event-stream record.
+  ///
+  /// Keyed by test ID alone. A parameterized test gets one `testStarted` and one `testEnded`, the
+  /// latter only after every case has ended, so a hung case keeps its test here and the test is
+  /// named. The cases' own `testCaseStarted` and `testCaseEnded` records carry no case identity in
+  /// this ABI version (`_testCase` is left out), so the hung case itself cannot be named.
+  func observe(_ recordJSON: JSON) {
+    guard
+      case .object(let record) = recordJSON,
+      case .string("event") = record["kind"],
+      case .object(let payload) = record["payload"],
+      case .string(let kind) = payload["kind"],
+      case .string(let testID) = payload["testID"]
+    else {
+      return
+    }
+    switch kind {
+    case "testStarted":
+      guard !isSuite(testID) else { return }
+      let now = ContinuousClock.now
+      running.withLock { $0[testID] = Running(startedAt: now, reported: false) }
+    case "testEnded", "testSkipped":
+      running.withLock { _ = $0.removeValue(forKey: testID) }
+    default:
+      break
+    }
+  }
+
+  func start() {
+    let thread = Thread { [self] in
+      while !stopped.value {
+        Thread.sleep(forTimeInterval: Self.seconds(Self.interval))
+        report()
+      }
+    }
+    thread.name = "StalledTestWatchdog"
+    thread.start()
+  }
+
+  func stop() {
+    stopped.withLock { $0 = true }
+  }
+
+  private func report() {
+    let now = ContinuousClock.now
+    let stalled: [(String, Swift.Duration)] = running.withLock { running in
+      var stalled: [(String, Swift.Duration)] = []
+      for (testID, test) in running where !test.reported {
+        let elapsed = test.startedAt.duration(to: now)
+        guard elapsed >= Self.limit else { continue }
+        running[testID]?.reported = true
+        stalled.append((testID, elapsed))
+      }
+      return stalled
+    }
+    for (testID, elapsed) in stalled.sorted(by: { $0.0 < $1.0 }) {
+      let seconds = Int(Self.seconds(elapsed))
+      let line = "STALLED: test \(testID) still running after \(seconds)s\n"
+      FileHandle.standardError.write(Data(line.utf8))
+    }
+  }
+
+  private static func seconds(_ duration: Swift.Duration) -> Double {
+    let components = duration.components
+    return Double(components.seconds) + Double(components.attoseconds) / 1e18
+  }
+}
