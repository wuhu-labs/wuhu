+private func trimmingWhitespace(_ string: String) -> String {
+    guard let start = string.firstIndex(where: { !$0.isWhitespace }),
+          let end = string.lastIndex(where: { !$0.isWhitespace })
+    else { return "" }
+    return String(string[start...end])
+}
