{
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "include": [
        "no-sparse-arrays"
      ]
    }
  },
  "tasks": {
    "generate-manifests": "deno run --allow-read --allow-write --allow-net=github.com,codeload.github.com,objects.githubusercontent.com,release-assets.githubusercontent.com --allow-run=git,tar,which,xcodegen tools/manifest-gen/generate.ts --apply --all --umbrella --module --public-tree",
    "fmt-test": "deno fmt --check --ignore=tools/iconamoon/svg tools",
    "lint-test": "deno lint tools",
    "contract-ts-emit-test": "deno test --allow-read tools/contract-ts/emit_test.ts",
    "swiftlint": "swiftlint lint --strict --quiet --no-cache --config .swiftlint.yml packages",
    "swiftlint-rules-test": "deno test -A bazel/swiftlint/rules_test.ts",
    "swiftformat-lint": "swiftformat --lint . --cache ignore"
  },
  "imports": {
    "@opentelemetry/api": "npm:@opentelemetry/api@1.9.0",
    "@std/assert": "jsr:@std/assert@1.0.13",
    "@std/path": "jsr:@std/path@1.0.8",
    "@std/yaml": "jsr:@std/yaml@1.0.5",
    "jose": "npm:jose@6.1.0",
    "marked": "npm:marked@17.0.6"
  }
}
