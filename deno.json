{
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "include": [
        "no-sparse-arrays"
      ]
    }
  },
  "tasks": {
    "generate-manifests": "deno run --allow-read --allow-write --allow-net=github.com,codeload.github.com,objects.githubusercontent.com,release-assets.githubusercontent.com,api.appstoreconnect.apple.com --allow-env=HOME --allow-run=git,tar,which,xcodegen,security tools/manifest-gen/generate.ts --apply --all --umbrella --module --public-tree",
    "fmt-test": "deno fmt --check --ignore=tools/iconamoon/svg tools",
    "lint-test": "deno lint tools",
    "contract-ts-emit-test": "deno test --allow-read tools/contract-ts/emit_test.ts"
  },
  "tests": {
    "fmt-test": {
      "platforms": [
        "linux",
        "mac"
      ],
      "inputs": [
        ".gitignore"
      ]
    },
    "lint-test": {
      "platforms": [
        "linux",
        "mac"
      ],
      "inputs": [
        ".gitignore"
      ]
    },
    "release-tooling-test": {
      "platforms": [
        "linux",
        "mac"
      ],
      "inputs": [
        "packages/*/package.yml",
        "packages/*/Apps/*/app.yml",
        "packages/wuhu-core/Targets/wuhu/target.yml",
        "packages/wuhu-desktop/deno.json"
      ]
    },
    "skill-bench-test": {
      "platforms": [
        "linux",
        "mac"
      ]
    },
    "ci-prune-test": {
      "platforms": [
        "linux",
        "mac"
      ]
    },
    "ci-lanes-test": {
      "platforms": [
        "linux",
        "mac"
      ],
      "inputs": [
        ".forgejo/workflows/ci.yml"
      ]
    },
    "module-profile-test": {
      "platforms": [
        "linux",
        "mac"
      ],
      "inputs": [
        ".agents/skills/mac-worker-setup/pin.env",
        "packages/build-pool/src",
        "packages/space-oidc/src"
      ]
    },
    "ci-failure-labels-test": {
      "platforms": [
        "linux",
        "mac"
      ]
    },
    "check-tooling-test": {
      "platforms": [
        "linux",
        "mac"
      ],
      "inputs": [
        "packages/*/package.yml",
        "packages/*/Apps/*/app.yml",
        "packages/*/Targets/*/target.yml",
        ".agents/skills/mac-worker-setup/pin.env",
        ".gitattributes",
        ".githooks/pre-commit",
        ".gitignore",
        "MODULE.bazel.template",
        "bazel/rules",
        "bazel/umbrella/Package.resolved",
        "packages/build-pool/src",
        "packages/hmr-sidecar/src",
        "packages/space-oidc/src",
        "packages/wuhu-app/Targets/Application/Sources/HotReload.swift"
      ]
    },
    "signing-tooling-test": {
      "platforms": [
        "linux",
        "mac"
      ],
      "inputs": [
        "packages/*/package.yml",
        "packages/*/Apps/*/app.yml"
      ]
    },
    "public-links-test": {
      "platforms": [
        "linux",
        "mac"
      ],
      "inputs": [
        "products/wuhu/public",
        "packages/wuhu-core/Targets/*/SPEC.md",
        "packages/wuhu-core/Targets/*/Tests/contract",
        "packages/wuhu-core/Targets/SpaceToolReference/Tests/reference"
      ]
    },
    "mac-worker-xcode-pin-test": {
      "platforms": [
        "linux"
      ],
      "inputs": [
        ".agents/skills/mac-worker-setup"
      ]
    },
    "machine-v2-driver-smoke-test": {
      "platforms": [
        "linux",
        "mac"
      ]
    },
    "contract-ts-emit-test": {
      "platforms": [
        "linux",
        "mac"
      ]
    }
  },
  "imports": {
    "@opentelemetry/api": "npm:@opentelemetry/api@1.9.0",
    "@std/assert": "jsr:@std/assert@1.0.13",
    "@std/path": "jsr:@std/path@1.0.8",
    "@std/yaml": "jsr:@std/yaml@1.0.5",
    "jose": "npm:jose@6.1.0",
    "marked": "npm:marked@17.0.6"
  }
}
