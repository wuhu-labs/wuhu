{
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "include": [
        "no-sparse-arrays"
      ]
    }
  },
  "tasks": {
    "generate-manifests": "deno run --allow-read --allow-write --allow-net=github.com,codeload.github.com,objects.githubusercontent.com,release-assets.githubusercontent.com --allow-run=git,tar,which,xcodegen tools/manifest-gen/generate.ts --apply --all --umbrella --module --public-tree",
    "fmt-test": "deno fmt --check --ignore=tools/iconamoon/svg tools",
    "lint-test": "deno lint tools",
    "contract-ts-emit-test": "deno test --allow-read tools/contract-ts/emit_test.ts"
  },
