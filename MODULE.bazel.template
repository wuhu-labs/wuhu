http_archive(
    name = "deno_darwin_arm64",
    build_file_content = """exports_files(["deno"], visibility = ["//visibility:public"])""",
    sha256 = "ee3473502118eab301eca93aa6b31d6b0b6c1602d0f59e4cb89d4a262b12f6e7",
    url = "https://github.com/denoland/deno/releases/download/v2.9.1/deno-aarch64-apple-darwin.zip",
)

http_archive(
    name = "deno_linux_x86_64",
    build_file_content = """exports_files(["deno"], visibility = ["//visibility:public"])""",
    sha256 = "710c54d63477d1100844ef4818f19507ce0dbf40510903b1d883f19e394446a2",
    url = "https://github.com/denoland/deno/releases/download/v2.9.1/deno-x86_64-unknown-linux-gnu.zip",
)

http_archive(
    name = "deno_linux_arm64",
    build_file_content = """exports_files(["deno"], visibility = ["//visibility:public"])""",
    sha256 = "0a60d079fa79635a59803074dbbfe86ccc35746dc2c4f8d73f2e50338b3283a9",
    url = "https://github.com/denoland/deno/releases/download/v2.9.1/deno-aarch64-unknown-linux-gnu.zip",
)

{{package_modules}}

# quickjs-ng v0.15.1 (github.com/quickjs-ng/quickjs, tag v0.15.1), the
# maintained fork of Bellard's QuickJS. Fetched, never vendored: only the four
# translation units its own CMakeLists names as `qjs_sources` are compiled
# (dtoa.c, libregexp.c, libunicode.c, quickjs.c) plus the private headers they
# include; `quickjs.h` alone is public, which is also what the generated Clang
# module for `import CQuickJS` covers. The copts mirror the warning
# suppressions and `-funsigned-char` that upstream's build applies to the same
# sources. MIT licensed; LICENSE rides in the archive. One patch: upstream
# frees a module while a top-level await still pending at context teardown
# holds it, and the runtime's final GC then aborts or corrupts the heap
# (bellard/quickjs#280, still open on quickjs-ng master).
http_archive(
    name = "quickjs",
    build_file_content = """
load("@build_bazel_rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

swift_interop_hint(
    name = "quickjs_interop",
    module_name = "CQuickJS",
)

exports_files(glob(["*.c"]), visibility = ["@//tools/quickjs-wasm:__pkg__"])

cc_library(
    name = "headers",
    visibility = ["@//tools/quickjs-wasm:__pkg__"],
    hdrs = glob(["*.h"]),
    includes = ["."],
)

cc_library(
    name = "quickjs",
    srcs = [
        "dtoa.c",
        "libregexp.c",
        "libunicode.c",
        "quickjs.c",
    ] + glob(["*.h"], exclude = ["quickjs.h"]),
    hdrs = ["quickjs.h"],
    aspect_hints = [":quickjs_interop"],
    copts = [
        "-funsigned-char",
        "-Wno-array-bounds",
        "-Wno-implicit-fallthrough",
        "-Wno-missing-field-initializers",
        "-Wno-sign-compare",
        "-Wno-unused-but-set-variable",
        "-Wno-unused-parameter",
        "-Wno-unused-result",
    ],
    includes = ["."],
    linkopts = select({
        "@platforms//os:linux": [
            "-lm",
            "-ldl",
            "-lpthread",
        ],
        "//conditions:default": [],
    }),
    local_defines = ["_GNU_SOURCE"],
)
""",
    patch_args = ["-p1"],
    patches = ["//bazel/patches:quickjs-pending-module-free.patch"],
    sha256 = "c4e813951b7c46845096a948e978c620b11ab4cf5fd622ca09c727ec31f42623",
    strip_prefix = "quickjs-0.15.1",
    url = "https://github.com/quickjs-ng/quickjs/archive/refs/tags/v0.15.1.tar.gz",
)

http_archive(
    name = "quickjs_emscripten",
    build_file = "//tools/quickjs-wasm:upstream.BUILD.bazel",
    patch_args = ["-p1"],
    patches = ["//tools/quickjs-wasm:interface-includes.patch"],
    sha256 = "cf3f2aa0d27ab3be9c1599682c2815de6ad8e9498daeca6eecd2434850b6c4b1",
    strip_prefix = "quickjs-emscripten-0.32.0",
    url = "https://github.com/justjake/quickjs-emscripten/archive/refs/tags/v0.32.0.tar.gz",
)

http_archive(
    name = "quickjs_ffi",
    build_file_content = 'exports_files(["dist/ffi.mjs"], visibility = ["//visibility:public"])',
    sha256 = "feb879d9c539f03717afe939d798defc40632642e91eccccbcabe54fafbe0025",
    strip_prefix = "package",
    url = "https://registry.npmjs.org/@jitl/quickjs-ng-wasmfile-release-sync/-/quickjs-ng-wasmfile-release-sync-0.32.0.tgz",
)

http_archive(
    name = "quickjs_core",
    build_file_content = 'filegroup(name = "modules", srcs = glob(["dist/*.mjs"]), visibility = ["//visibility:public"])',
    sha256 = "2ea4461a54e87217adf3f2b327c130d8f6b034e334f9e7d87c0580d0406a206e",
    strip_prefix = "package",
    url = "https://registry.npmjs.org/quickjs-emscripten-core/-/quickjs-emscripten-core-0.32.0.tgz",
)

http_archive(
    name = "quickjs_ffi_types",
    build_file_content = 'exports_files(["dist/index.mjs"], visibility = ["//visibility:public"])',
    sha256 = "d7bf18745d8fb2144587fcfd15982a1a87347f6675538615623c3267c51965b1",
    strip_prefix = "package",
    url = "https://registry.npmjs.org/@jitl/quickjs-ffi-types/-/quickjs-ffi-types-0.32.0.tgz",
)

# Apple CC toolchain configuration.
