module(
    name = "wuhu_app",
    version = "0",
    bazel_compatibility = [">=9.0.0"],
)

bazel_dep(name = "apple_support", version = "2.5.4", repo_name = "build_bazel_apple_support")
bazel_dep(name = "bazel_skylib", version = "1.8.1")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_apple", version = "4.5.3", repo_name = "build_bazel_rules_apple")
bazel_dep(name = "rules_cc", version = "0.2.19")
bazel_dep(name = "rules_swift", version = "3.6.1", repo_name = "build_bazel_rules_swift")
bazel_dep(name = "rules_swift_package_manager", version = "1.17.1")

single_version_override(
    module_name = "rules_apple",
    patch_strip = 1,
    patches = [
        "//bazel/patches:rules-apple-visionos-dynamic-framework-constraints.patch",
        "//bazel/patches:rules-apple-app-intents-single-module-shortcuts.patch",
        "//bazel/patches:rules-apple-visionos-test-rule-keywords.patch",
    ],
    version = "4.5.3",
)

# swift-testing's console recorder prints a started and a passed line for every run, suite, test
# and parameterized case at its default verbosity, and the runner rules_swift generates hands the
# framework's ABI entry point a configuration that never sets one
# (`tools/test_observer/SwiftTestingRunner.swift`, `runTests`). Under `--test_output=errors` a
# single failing case therefore replays hundreds of ticks before the one line that matters. The
# generated runner ignores argv, so `--test_arg` cannot reach it, and swift-testing has no
# verbosity environment variable, so that one configuration key is the only knob there is.
single_version_override(
    module_name = "rules_swift",
    patch_strip = 1,
    patches = ["//bazel/patches:rules-swift-swift-testing-quiet.patch"],
    version = "3.6.1",
)

# Our fork of rules_swift_package_manager 1.17.1. Upstream always enables a
# dependency's own default traits and ignores every `.package(traits:)`
# selection in the graph; the fork implements SwiftPM trait unification
# (SE-0450: a package's enabled traits are the union of the selections from
# all of its dependents) plus a per-package `traits` override on
# `configure_package` for deliberate deviations. Upstream tracks the gap as
# cgrindel/rules_swift_package_manager#2137; the fork branch is
# xnzg/rules_swift_package_manager#consumer-traits, intended for upstreaming.
archive_override(
    module_name = "rules_swift_package_manager",
    integrity = "sha256-Gk9qolXlI5HfkcOwihD11MMlAbXpSVIz2Ws8+z3rLKc=",
    strip_prefix = "rules_swift_package_manager-20be64cf7ddfd1254bc381384b1ef593522e28f8",
    urls = ["https://github.com/xnzg/rules_swift_package_manager/archive/20be64cf7ddfd1254bc381384b1ef593522e28f8.tar.gz"],
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Hash-pinned deno toolchain (2.9.1) for the in-graph web bundle and deno
# tests (repo-layout laws 4/5/7). Never the host deno. //bazel/rules:deno
# selects the binary for the exec platform.
http_archive(
    name = "deno_darwin_arm64",
    build_file_content = """exports_files(["deno"], visibility = ["//visibility:public"])""",
    sha256 = "ee3473502118eab301eca93aa6b31d6b0b6c1602d0f59e4cb89d4a262b12f6e7",
    url = "https://github.com/denoland/deno/releases/download/v2.9.1/deno-aarch64-apple-darwin.zip",
)

http_archive(
    name = "deno_linux_x86_64",
    build_file_content = """exports_files(["deno"], visibility = ["//visibility:public"])""",
    sha256 = "710c54d63477d1100844ef4818f19507ce0dbf40510903b1d883f19e394446a2",
    url = "https://github.com/denoland/deno/releases/download/v2.9.1/deno-x86_64-unknown-linux-gnu.zip",
)

http_archive(
    name = "deno_linux_arm64",
    build_file_content = """exports_files(["deno"], visibility = ["//visibility:public"])""",
    sha256 = "0a60d079fa79635a59803074dbbfe86ccc35746dc2c4f8d73f2e50338b3283a9",
    url = "https://github.com/denoland/deno/releases/download/v2.9.1/deno-aarch64-unknown-linux-gnu.zip",
)

{{package_modules}}

# quickjs-ng v0.15.1 (github.com/quickjs-ng/quickjs, tag v0.15.1), the
# maintained fork of Bellard's QuickJS. Fetched, never vendored: only the four
# translation units its own CMakeLists names as `qjs_sources` are compiled
# (dtoa.c, libregexp.c, libunicode.c, quickjs.c) plus the private headers they
# include; `quickjs.h` alone is public, which is also what the generated Clang
# module for `import CQuickJS` covers. The copts mirror the warning
# suppressions and `-funsigned-char` that upstream's build applies to the same
# sources. MIT licensed; LICENSE rides in the archive. One patch: upstream
# frees a module while a top-level await still pending at context teardown
# holds it, and the runtime's final GC then aborts or corrupts the heap
# (bellard/quickjs#280, still open on quickjs-ng master).
http_archive(
    name = "quickjs",
    build_file_content = """
load("@build_bazel_rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

swift_interop_hint(
    name = "quickjs_interop",
    module_name = "CQuickJS",
)

cc_library(
    name = "quickjs",
    srcs = [
        "dtoa.c",
        "libregexp.c",
        "libunicode.c",
        "quickjs.c",
    ] + glob(["*.h"], exclude = ["quickjs.h"]),
    hdrs = ["quickjs.h"],
    aspect_hints = [":quickjs_interop"],
    copts = [
        "-funsigned-char",
        "-Wno-array-bounds",
        "-Wno-implicit-fallthrough",
        "-Wno-missing-field-initializers",
        "-Wno-sign-compare",
        "-Wno-unused-but-set-variable",
        "-Wno-unused-parameter",
        "-Wno-unused-result",
    ],
    includes = ["."],
    linkopts = select({
        "@platforms//os:linux": [
            "-lm",
            "-ldl",
            "-lpthread",
        ],
        "//conditions:default": [],
    }),
    local_defines = ["_GNU_SOURCE"],
)
""",
    patch_args = ["-p1"],
    patches = ["//bazel/patches:quickjs-pending-module-free.patch"],
    sha256 = "c4e813951b7c46845096a948e978c620b11ab4cf5fd622ca09c727ec31f42623",
    strip_prefix = "quickjs-0.15.1",
    url = "https://github.com/quickjs-ng/quickjs/archive/refs/tags/v0.15.1.tar.gz",
)

# Apple CC toolchain configuration.
apple_cc_configure = use_extension(
    "@build_bazel_apple_support//crosstool:setup.bzl",
    "apple_cc_configure_extension",
)
use_repo(apple_cc_configure, "local_config_apple_cc")

# Import external SwiftPM dependencies from the umbrella package.
swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
{{swift_deps_configure}}
swift_deps.from_package(
    resolved = "//bazel/umbrella:Package.resolved",
    swift = "//bazel/umbrella:Package.swift",
)
use_repo(
    swift_deps,
{{swift_deps_repos}}
)
