# SwiftLint builds its own SwiftSyntax, separate from ours (bazel/swiftlint).
swiftlint_extra_rules = use_extension("@swiftlint//bazel:extensions.bzl", "extra_rules")
swiftlint_extra_rules.setup(srcs = "//bazel/swiftlint:ExtraRules.swift")

single_version_override(
    module_name = "rules_apple",
    patch_strip = 1,
    patches = [
        "//bazel/patches:rules-apple-imported-framework-helper-modes.patch",
        "//bazel/patches:rules-apple-visionos-dynamic-framework-constraints.patch",
        "//bazel/patches:rules-apple-app-intents-single-module-shortcuts.patch",
        "//bazel/patches:rules-apple-visionos-test-rule-keywords.patch",
        # One target file per patch: Bazel's native patcher (ctx.patch) rejects these identical
        # profile-guard hunks when several files share one patch (CONTENT_DOES_NOT_MATCH_TARGET),
        # though GNU patch applies the combined file cleanly.
        "//bazel/patches:rules-apple-unsigned-device-profiles-ios.patch",
        "//bazel/patches:rules-apple-unsigned-device-profiles-tvos.patch",
        "//bazel/patches:rules-apple-unsigned-device-profiles-visionos.patch",
        "//bazel/patches:rules-apple-unsigned-device-profiles-watchos.patch",
    ],
    version = "4.5.3",
)

# swift-testing's console recorder prints a started and a passed line for every run, suite, test
# and parameterized case at its default verbosity, and the runner rules_swift generates hands the
# framework's ABI entry point a configuration that never sets one
# (`tools/test_observer/SwiftTestingRunner.swift`, `runTests`). Under `--test_output=errors` a
# single failing case therefore replays hundreds of ticks before the one line that matters. The
# generated runner ignores argv, so `--test_arg` cannot reach it, and swift-testing has no
# verbosity environment variable, so that one configuration key is the only knob there is.
# Quiet, a run killed at Bazel's test timeout names no test at all: the runner reads the event
# stream only after the run returns. The stalled-test watchdog reads it live and prints a
# `STALLED:` line naming every test still running after 60 seconds.
single_version_override(
    module_name = "rules_swift",
    patch_strip = 1,
    patches = [
        "//bazel/patches:rules-swift-swift-testing-quiet.patch",
        "//bazel/patches:rules-swift-linux-toolchain-watch.patch",
        "//bazel/patches:rules-swift-test-runner-completion.patch",
        "//bazel/patches:rules-swift-stalled-test-watchdog.patch",
    ],
    version = "3.6.1",
)

# rules_cc's autodetected Linux toolchain writes a module map listing every header on the host,
# and every C/C++ compile takes it as an input: the Linux build pool and the public build's
# image differed only in a few unrelated -dev packages and shared no C action keys.
# The map serves layering_check alone, which nothing here enables; Apple toolchains come from
# apple_support and carry their own.
single_version_override(
    module_name = "rules_cc",
    patch_strip = 1,
    patches = ["//bazel/patches:rules-cc-no-system-module-map.patch"],
    version = "0.2.25",
)

# Our fork of rules_swift_package_manager 1.17.1. Upstream always enables a
# dependency's own default traits and ignores every `.package(traits:)`
# selection in the graph; the fork implements SwiftPM trait unification
# (SE-0450: a package's enabled traits are the union of the selections from
# all of its dependents) plus a per-package `traits` override on
# `configure_package` for deliberate deviations. Upstream tracks the gap as
# cgrindel/rules_swift_package_manager#2137; the fork branch is
# xnzg/rules_swift_package_manager#consumer-traits, intended for upstreaming.
archive_override(
    module_name = "rules_swift_package_manager",
    patch_strip = 1,
    patches = ["//bazel/patches:rspm-stable-trait-requests.patch"],
    integrity = "sha256-Gk9qolXlI5HfkcOwihD11MMlAbXpSVIz2Ws8+z3rLKc=",
    strip_prefix = "rules_swift_package_manager-20be64cf7ddfd1254bc381384b1ef593522e28f8",
    urls = ["https://github.com/xnzg/rules_swift_package_manager/archive/20be64cf7ddfd1254bc381384b1ef593522e28f8.tar.gz"],
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

