event: response.created
data: {"type":"response.created","response":{"id":"resp_02351bfa3e2c31b9016a985cee95e887d09367e23a03fc1361","object":"response","created_at":1788370158,"status":"in_progress","background":false,"completed_at":null,"error":null,"frequency_penalty":0.0,"incomplete_details":null,"instructions":null,"max_output_tokens":128000,"max_tool_calls":null,"model":"gpt-5.6-luna","moderation":null,"output":[],"parallel_tool_calls":true,"presence_penalty":0.0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_retention":"24h","reasoning":{"context":"all_turns","effort":"medium","mode":"standard","summary":"detailed"},"safety_identifier":null,"service_tier":"auto","store":false,"temperature":1.0,"text":{"format":{"type":"text"},"verbosity":"medium"},"tool_choice":"auto","tool_usage":{"image_gen":{"input_tokens":0,"input_tokens_details":{"image_tokens":0,"text_tokens":0},"output_tokens":0,"output_tokens_details":{"image_tokens":0,"text_tokens":0},"total_tokens":0},"web_search":{"num_requests":0}},"tools":[{"type":"function","description":"Read a file. Paths resolve against your current mount (see the mount tool); machines://<id>/<path> addresses a machine directly. Text output is clamped to 2000 lines / 50KB with a continuation notice. Images (png, jpg, jpeg, gif, webp; up to 3MB) arrive as attached images; other binary files are refused.","name":"read","output_schema":null,"parameters":{"type":"object","properties":{"path":{"type":"string","description":"File path, relative to the current mount or absolute."},"lines":{"type":"string","description":"Line window \"A-B\" or \"A-\" (1-indexed, inclusive), e.g. from a truncation notice."}},"required":["path"],"additionalProperties":false},"strict":false},{"type":"function","description":"Create or replace a file. The space filesystem is path-keyed: writing any path creates it, parent directories are implicit, and there is no mkdir. Overwriting requires a prior read at the file's current version; stale or missing reads fail and ask you to re-read.","name":"write","output_schema":null,"parameters":{"type":"object","properties":{"path":{"type":"string","description":"File path, relative to the current mount or absolute."},"content":{"type":"string","description":"Full file content to write."}},"required":["path","content"],"additionalProperties":false},"strict":false},{"type":"function","description":"Apply exact old/new text replacements to a file you have read at its current version. Each old string must match exactly once.","name":"edit","output_schema":null,"parameters":{"type":"object","properties":{"path":{"type":"string","description":"File path, relative to the current mount or absolute."},"edits":{"type":"array","description":"Replacements applied in order.","items":{"type":"object","properties":{"old":{"type":"string","description":"Exact text to replace; widen with context until unique."},"new":{"type":"string","description":"Replacement text."}},"required":["old","new"],"additionalProperties":false}}},"required":["path","edits"],"additionalProperties":false},"strict":false},{"type":"function","description":"Search file contents with a regular expression under a directory (default: the current mount). Matched lines are shortened past 500 bytes.","name":"grep","output_schema":null,"parameters":{"type":"object","properties":{"pattern":{"type":"string","description":"Regular expression to search for."},"path":{"type":"string","description":"Directory or file to search, relative to the current mount."},"match_limit":{"type":"integer","description":"Maximum matches to return (default 50)."},"entry_limit":{"type":"integer","description":"Maximum files to scan (default 1000)."},"step":{"type":"string","description":"Continuation cursor from a previous grep result."}},"required":["pattern"],"additionalProperties":false},"strict":false},{"type":"function","description":"Find files by glob under a directory (default: the current mount).","name":"find","output_schema":null,"parameters":{"type":"object","properties":{"glob":{"type":"string","description":"Glob pattern, e.g. **/*.swift."},"path":{"type":"string","description":"Directory to search, relative to the current mount."},"match_limit":{"type":"integer","description":"Maximum paths to return (default 50)."},"entry_limit":{"type":"integer","description":"Maximum entries to scan (default 1000)."},"step":{"type":"string","description":"Continuation cursor from a previous find result."}},"required":["glob"],"additionalProperties":false},"strict":false},{"type":"function","description":"Run a shell command on the mounted machine (sh -c). Requires the current mount to be machines://<id>/...; the mount path is the working directory. Space files never need a shell — create them with write.","name":"exec","output_schema":null,"parameters":{"type":"object","properties":{"command":{"type":"string","description":"Shell command line."},"cwd":{"type":"string","description":"Working directory override, relative to the mount."},"timeout_seconds":{"type":"number","description":"Kill the command after this many seconds."},"max_output":{"type":"integer","description":"Output byte budget (default 1 MiB); the command is killed past it. The result shows the last 2000 lines / 50KB."}},"required":["command"],"additionalProperties":false},"strict":false},{"type":"function","description":"Declare your working location — the space filesystem (\"/...\") or a machine (\"machines://<id>/<path>\"). Later relative paths resolve against the most recent mount.","name":"mount","output_schema":null,"parameters":{"type":"object","properties":{"location":{"type":"string","description":"Absolute space path or machines:// address."}},"required":["location"],"additionalProperties":false},"strict":false},{"type":"function","description":"List the machines enrolled in this space: id, whether it is attached right now, and the alias a human named it (\"mac mini\"). Aliases are how humans will ask for a box; the id is what mount and exec address. A detached machine refuses reads and execs until it dials back in.","name":"machines","output_schema":null,"parameters":{"type":"object","properties":{},"required":[],"additionalProperties":false},"strict":false},{"type":"function","description":"Subscribe to a read-only SQL query over the space database; you receive a message whenever its results change. Cancel with cancel_observation.","name":"observe","output_schema":null,"parameters":{"type":"object","properties":{"sql":{"type":"string","description":"Read-only SQL over space tables and induced tables (docs, links, sessions, ...)."},"throttle_seconds":{"type":"number","description":"Minimum seconds between change notifications (default 30)."}},"required":["sql"],"additionalProperties":false},"strict":false},{"type":"function","description":"Schedule a message back to yourself: once after in_seconds, or repeatedly on a 5-field UTC cron expression. Cancel with cancel_timer.","name":"timer","output_schema":null,"parameters":{"type":"object","properties":{"message":{"type":"string","description":"The message you will receive when the timer fires."},"in_seconds":{"type":"number","description":"Fire once after this many seconds."},"cron":{"type":"string","description":"Fire repeatedly: \"minute hour day month weekday\" in UTC."}},"required":["message"],"additionalProperties":false},"strict":false},{"type":"function","description":"Cancel an observation subscription.","name":"cancel_observation","output_schema":null,"parameters":{"type":"object","properties":{"subscription_id":{"type":"string","description":"The subscription id an observe result reported."}},"required":["subscription_id"],"additionalProperties":false},"strict":false},{"type":"function","description":"Cancel a timer subscription.","name":"cancel_timer","output_schema":null,"parameters":{"type":"object","properties":{"subscription_id":{"type":"string","description":"The subscription id a timer result reported."}},"required":["subscription_id"],"additionalProperties":false},"strict":false},{"type":"function","description":"Run a read-only SQL query over the space database (space tables plus induced tables such as docs, links, and sessions).","name":"query","output_schema":null,"parameters":{"type":"object","properties":{"sql":{"type":"string","description":"Read-only SQL."}},"required":["sql"],"additionalProperties":false},"strict":false},{"type":"function","description":"Post a message into a conversation. With no target argument it posts into your own box — the public surface people comment on. Pass conversation for a group you are in, session to reach another session (its box if it is an agent, your DM with it if it is a task), or user to DM a person. reply_target points at one earlier message in the same conversation; it is decoration, not a requirement.","name":"send_message","output_schema":null,"parameters":{"type":"object","properties":{"message":{"type":"string","description":"Message text."},"conversation":{"type":"string","description":"Conversation id to post into."},"session":{"type":"string","description":"Session to reach: its box if an agent, your DM with it if a task."},"user":{"type":"string","description":"User to DM; the DM is created on first post."},"reply_target":{"type":"string","description":"Message id this answers, from that message's message-id header."}},"required":["message"],"additionalProperties":false},"strict":false},{"type":"function","description":"Open a request on a task you created: the message lands in your DM with it and it owes you a final report. One open request per task — request again only after its final. A deadline is your backstop, not the task's: on expiry you are told, and you decide to re-request, kill or replace.","name":"request","output_schema":null,"parameters":{"type":"object","properties":{"task":{"type":"string","description":"Session id of a task you created."},"message":{"type":"string","description":"What you are asking it to do."},"deadline_seconds":{"type":"number","description":"Tell me if there is no final report within this many seconds."}},"required":["task","message"],"additionalProperties":false},"strict":false},{"type":"function","description":"Report on the request open against you. progress is a status line your parent sees without the request closing; final answers it and closes it. request_id is never inferred — take it from the request message's header.","name":"report","output_schema":null,"parameters":{"type":"object","properties":{"request_id":{"type":"string","description":"The open request's id."},"kind":{"type":"string","description":"progress or final."},"content":{"type":"string","description":"Report text."}},"required":["request_id","kind","content"],"additionalProperties":false},"strict":false},{"type":"function","description":"Create a child task. With expects_reply it starts working on message and owes you a final report; without, it is detached — no report, no duty — which is how you prime context for a human who then takes over. Omitted executor, provider, model and effort default to your own; a template's values win over that default, and explicit arguments win over both. Contractor sessions take advisory model/effort plus an opaque extra config bag.","name":"create_session","output_schema":null,"parameters":{"type":"object","properties":{"title":{"type":"string","description":"Task title."},"message":{"type":"string","description":"The brief; required with expects_reply."},"expects_reply":{"type":"boolean","description":"Open a request on the new task so it reports back."},"executor":{"type":"string","description":"kernel (default) or contractor:<name>."},"provider":{"type":"string","description":"Model provider id, e.g. anthropic. Kernel sessions only."},"model":{"type":"string","description":"Model name as listed in the models data; advisory for contractor sessions."},"effort":{"type":"string","description":"Reasoning effort; defaults to the model's default."},"tags":{"type":"array","description":"Query/filter tags; never read by the session.","items":{"type":"string"}},"extra":{"type":"object","description":"Contractor executor config, stored verbatim."},"template":{"type":"string","description":"Session template name (/templates/<name>/): its template.json fills parameters you leave out and its files are cloned into the new task's home."}},"required":["title"],"additionalProperties":false},"strict":false},{"type":"function","description":"Drop a named marker in the transcript. A later compact call can fold everything before a bookmark while keeping what follows.","name":"bookmark","output_schema":null,"parameters":{"type":"object","properties":{"name":{"type":"string","description":"Bookmark name to reference from compact."}},"required":[],"additionalProperties":false},"strict":false},{"type":"function","description":"Compact the conversation: everything before the cut is replaced by your summary. Name a bookmark to keep the transcript after it; omit it to fold everything. List files to re-read and mounts to re-declare so the next generation re-establishes its working context.","name":"compact","output_schema":null,"parameters":{"type":"object","properties":{"summary":{"type":"string","description":"Summary that replaces the folded transcript."},"pre_reads":{"type":"array","description":"File paths to re-read at the head of the new generation.","items":{"type":"string"}},"mounts":{"type":"array","description":"Mount locations to re-declare; defaults to the currently declared stack.","items":{"type":"string"}},"bookmark":{"type":"string","description":"Keep the transcript after this bookmark."}},"required":["summary"],"additionalProperties":false},"strict":false}],"top_logprobs":0,"top_p":0.98,"truncation":"disabled","usage":null,"user":null,"metadata":{}},"sequence_number":0}

