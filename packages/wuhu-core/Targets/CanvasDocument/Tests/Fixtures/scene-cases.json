[
  {
    "name": "auto sides, straight, default arrow",
    "items": [
      { "id": "aaaaaa", "kind": "sticky", "x": 0, "y": 0, "w": 100, "h": 100, "color": "yellow", "text": "Hi" },
      { "id": "bbbbbb", "kind": "rect", "x": 300, "y": 50, "w": 100, "h": 100, "color": "blue" }
    ],
    "connectors": [
      { "id": "c00001", "from": "aaaaaa", "to": "bbbbbb", "style": "straight" }
    ],
    "expected": {
      "items": [
        { "id": "aaaaaa", "frame": [0, 0, 100, 100], "fill": "#FFE48AFF" },
        { "id": "bbbbbb", "frame": [300, 50, 100, 100], "fill": "#C3DEFFFF", "stroke": { "color": "#7BAEECFF", "width": 1.5 } }
      ],
      "connectors": [
        { "id": "c00001", "points": [[100, 50], [300, 100]], "arrow": "end" }
      ]
    }
  },
  {
    "name": "elbow between horizontal sides with an offset and a label",
    "items": [
      { "id": "aaaaaa", "kind": "rect", "x": 0, "y": 0, "w": 100, "h": 100 },
      { "id": "bbbbbb", "kind": "rect", "x": 300, "y": 200, "w": 100, "h": 100 }
    ],
    "connectors": [
      { "id": "c00001", "from": "aaaaaa", "to": "bbbbbb", "fromSide": "right", "toSide": "left", "style": "elbow", "offset": 20, "arrow": "none", "label": "go" }
    ],
    "expected": {
      "items": [
        { "id": "aaaaaa", "frame": [0, 0, 100, 100], "fill": "#E8E8E8FF", "stroke": { "color": "#B0B0B0FF", "width": 1.5 } },
        { "id": "bbbbbb", "frame": [300, 200, 100, 100], "fill": "#E8E8E8FF", "stroke": { "color": "#B0B0B0FF", "width": 1.5 } }
      ],
      "connectors": [
        { "id": "c00001", "points": [[100, 50], [220, 50], [220, 250], [300, 250]], "arrow": "none", "labelAnchor": [220, 130] }
      ]
    }
  },
  {
    "name": "elbow between vertical auto sides",
    "items": [
      { "id": "aaaaaa", "kind": "ellipse", "x": 0, "y": 0, "w": 100, "h": 100, "color": "green" },
      { "id": "bbbbbb", "kind": "diamond", "x": 20, "y": 300, "w": 100, "h": 100, "color": "purple" }
    ],
    "connectors": [
      { "id": "c00001", "from": "aaaaaa", "to": "bbbbbb", "style": "elbow" }
    ],
    "expected": {
      "items": [
        { "id": "aaaaaa", "frame": [0, 0, 100, 100], "fill": "#C2EBC8FF", "stroke": { "color": "#78C589FF", "width": 1.5 } },
        { "id": "bbbbbb", "frame": [20, 300, 100, 100], "fill": "#DDCDFFFF", "stroke": { "color": "#A68AE8FF", "width": 1.5 } }
      ],
      "connectors": [
        { "id": "c00001", "points": [[50, 100], [50, 200], [70, 200], [70, 300]], "arrow": "end" }
      ]
    }
  },
  {
    "name": "elbow between perpendicular sides ignores the offset",
    "items": [
      { "id": "aaaaaa", "kind": "sticky", "x": 0, "y": 0, "w": 100, "h": 100, "color": "pink" },
      { "id": "bbbbbb", "kind": "sticky", "x": 300, "y": 300, "w": 100, "h": 100, "color": "gray" }
    ],
    "connectors": [
      { "id": "c00001", "from": "aaaaaa", "to": "bbbbbb", "fromSide": "right", "toSide": "top", "style": "elbow", "offset": 40, "arrow": "both" }
    ],
    "expected": {
      "items": [
        { "id": "aaaaaa", "frame": [0, 0, 100, 100], "fill": "#FFC4D8FF" },
        { "id": "bbbbbb", "frame": [300, 300, 100, 100], "fill": "#E8E8E8FF" }
      ],
      "connectors": [
        { "id": "c00001", "points": [[100, 50], [350, 50], [350, 300]], "arrow": "both" }
      ]
    }
  },
  {
    "name": "elbow straight across collapses to two points",
    "items": [
      { "id": "aaaaaa", "kind": "sticky", "x": 0, "y": 0, "w": 100, "h": 100 },
      { "id": "bbbbbb", "kind": "sticky", "x": 300, "y": 0, "w": 100, "h": 100 }
    ],
    "connectors": [
      { "id": "c00001", "from": "aaaaaa", "to": "bbbbbb", "style": "elbow", "label": "same row" }
    ],
    "expected": {
      "items": [
        { "id": "aaaaaa", "frame": [0, 0, 100, 100], "fill": "#FFE48AFF" },
        { "id": "bbbbbb", "frame": [300, 0, 100, 100], "fill": "#FFE48AFF" }
      ],
      "connectors": [
        { "id": "c00001", "points": [[100, 50], [300, 50]], "arrow": "end", "labelAnchor": [200, 50] }
      ]
    }
  },
  {
    "name": "sections paint first, children are relative, broken connectors are dropped",
    "items": [
      { "id": "s00001", "kind": "section", "x": 100, "y": 100, "w": 400, "h": 300, "color": "blue", "text": "Sprint" },
      { "id": "xxxxxx", "kind": "sticky", "parent": "s00001", "x": 20, "y": 40, "w": 100, "h": 100, "color": "pink" },
      { "id": "tttttt", "kind": "text", "x": 0, "y": 0, "w": 200, "h": 40, "text": "Note" },
      { "id": "s00002", "kind": "section", "x": 600, "y": 0, "w": 200, "h": 200 },
      { "id": "yyyyyy", "kind": "ellipse", "parent": "s00002", "x": 10, "y": 10, "w": 50, "h": 50 }
    ],
    "connectors": [
      { "id": "c00001", "from": "xxxxxx", "to": "yyyyyy", "fromSide": "top", "style": "straight" },
      { "id": "c00002", "from": "xxxxxx", "to": "zzzzzz", "style": "straight" },
      { "id": "c00003", "from": "xxxxxx", "to": "xxxxxx", "style": "elbow" }
    ],
    "expected": {
      "items": [
        { "id": "s00001", "frame": [100, 100, 400, 300], "fill": "#C3DEFF59", "stroke": { "color": "#7BAEECFF", "width": 1 } },
        { "id": "s00002", "frame": [600, 0, 200, 200], "fill": "#E8E8E859", "stroke": { "color": "#B0B0B0FF", "width": 1 } },
        { "id": "xxxxxx", "frame": [120, 140, 100, 100], "fill": "#FFC4D8FF" },
        { "id": "tttttt", "frame": [0, 0, 200, 40] },
        { "id": "yyyyyy", "frame": [610, 10, 50, 50], "fill": "#E8E8E8FF", "stroke": { "color": "#B0B0B0FF", "width": 1.5 } }
      ],
      "connectors": [
        { "id": "c00001", "points": [[170, 140], [610, 35]], "arrow": "end" }
      ]
    }
  },
  {
    "name": "file cards show images only for image paths",
    "items": [
      { "id": "ffffff", "kind": "file", "x": 0, "y": 0, "w": 240, "h": 160, "path": "/designs/hero.png" },
      { "id": "gggggg", "kind": "file", "x": 300, "y": 0, "w": 240, "h": 160, "path": "/notes/plan.wmd" }
    ],
    "connectors": [],
    "expected": {
      "items": [
        { "id": "ffffff", "frame": [0, 0, 240, 160], "fill": "#FFFFFFFF", "stroke": { "color": "#D0D0D0FF", "width": 1 }, "image": "/designs/hero.png" },
        { "id": "gggggg", "frame": [300, 0, 240, 160], "fill": "#FFFFFFFF", "stroke": { "color": "#D0D0D0FF", "width": 1 } }
      ],
      "connectors": []
    }
  }
]
