bazel_dep(name = "libpng", version = "1.6.58.bcr.1")
bazel_dep(name = "libjpeg_turbo", version = "3.1.3.bcr.6")

# Loro (github.com/loro-dev/loro-swift 1.17.1) for the Linux server: Apple
# targets take the same release through the SwiftPM external `Loro`, whose
# binaryTarget is Apple-only. The Swift half is upstream's uniffi bindings,
# compiled from the tag; the Rust half is libloro_swift.a built from the same
# tag by github.com/wuhu-labs/loro-upstreams (build.sh and PROVENANCE.md ride
# in the archive). patch_cmds keep the bindings off full Foundation: the only
# Foundation types they use are Data (FoundationEssentials) and NSLock, which
# becomes a pthread mutex of the same shape. MIT licensed.
http_archive(
    name = "loro_swift",
    build_file_content = """
load("@@rules_swift+//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

swift_library(
    name = "LoroLinux",
    srcs = glob(["Sources/Loro/*.swift"]),
    module_name = "Loro",
    copts = ["-swift-version", "5"],
    deps = ["@loro_ffi_linux//:loroFFI"],
)
""",
    patch_cmds = [
        "sed -i 's/^import Foundation$/import FoundationEssentials/' Sources/Loro/*.swift",
        "sed -i 's/Foundation\\.LocalizedError/LocalizedError/g' Sources/Loro/*.swift",
        "sed -i '/^fileprivate extension NSLock {$/,/^}$/d' Sources/Loro/LoroFFI.swift",
        "sed -i 's/private let lock = NSLock()/private let lock = UniffiLock()/' Sources/Loro/LoroFFI.swift",
        "test $(grep -c NSLock Sources/Loro/*.swift | awk -F: '{s+=$2} END {print s}') = 0",
        "printf 'import Glibc\\n\\nfinal class UniffiLock: @unchecked Sendable {\\n    private let mutex = UnsafeMutablePointer<pthread_mutex_t>.allocate(capacity: 1)\\n    init() { pthread_mutex_init(mutex, nil) }\\n    func withLock<T>(f: () throws -> T) rethrows -> T {\\n        pthread_mutex_lock(mutex)\\n        defer { pthread_mutex_unlock(mutex) }\\n        return try f()\\n    }\\n}\\n' > Sources/Loro/UniffiLock.swift",
    ],
    sha256 = "f6d086cbaf825c368b38aa963135659a5cc9ce82bde5ecbc002402f617e4ecaf",
    strip_prefix = "loro-swift-1.17.1",
    url = "https://github.com/loro-dev/loro-swift/archive/refs/tags/1.17.1.tar.gz",
)

http_archive(
    name = "loro_ffi_linux",
    build_file_content = """
load("@build_bazel_rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")
load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")

package(default_visibility = ["//visibility:public"])

swift_interop_hint(
    name = "loroFFI_interop",
    module_name = "loroFFI",
)

cc_import(
    name = "archive",
    static_library = "lib/libloro_swift.a",
)

cc_library(
    name = "loroFFI",
    hdrs = ["include/loroFFI.h"],
    aspect_hints = [":loroFFI_interop"],
    includes = ["include"],
    linkopts = ["-lpthread", "-ldl", "-lm"],
    deps = [":archive"],
)
""",
    sha256 = "d427995a994c28991c75e53b5201570a1ce8499f8bd46381bbad1cc502757e5f",
    strip_prefix = "loro-ffi-linux",
    url = "https://github.com/wuhu-labs/loro-upstreams/releases/download/1.17.1-linux.1/loro-ffi-1.17.1-linux.1-x86_64-linux-gnu.tar.gz",
)
