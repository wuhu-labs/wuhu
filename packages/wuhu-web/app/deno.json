{
  "owner": "wuhu",
  "exclude": [
    "app/lib/contract.gen.ts",
    "app/lib/space-url.vectors.json",
    ".react-router",
    "build",
    "app/lib/viewing.vectors.json",
    "public/_/worklets/bubble.js",
    "public/_/iconamoon.svg",
    "app/lib/widgets/quickjs/emscripten-module.browser.mjs",
    "app/lib/widgets/iconamoon-names.json",
    "app/lib/widgets/shared/prelude.js",
    "app/lib/widgets/shared/tree.js",
    "app/lib/widgets/shared/prelude.d.ts",
    "app/lib/widgets/shared/tree.d.ts"
  ],
  "generated": {
    "app/lib/contract.gen.ts": "//tools/contract-ts:space-contract",
    "app/lib/space-url.vectors.json": "//packages/wuhu-core:Targets/SpaceContract/Tests/contract/space-url-vectors.json",
    "app/lib/viewing.vectors.json": "//packages/wuhu-core:Targets/SpaceContract/Tests/contract/viewing-vectors.json",
    "app/lib/widgets/quickjs/emscripten-module.browser.mjs": "//tools/quickjs-wasm:emscripten-module.browser.mjs",
    "app/lib/widgets/quickjs/emscripten-module.wasm": "//tools/quickjs-wasm:emscripten-module.wasm",
    "app/lib/widgets/iconamoon-names.json": "//tools/iconamoon:names.json",
    "public/_/iconamoon.svg": "//tools/iconamoon:iconamoon.svg",
    "app/lib/widgets/shared/prelude.js": "//packages/widget-script-kit:Targets/WidgetScriptSource/Sources/Resources/prelude.js",
    "app/lib/widgets/shared/tree.js": "//packages/widget-script-kit:Targets/WidgetScriptSource/Sources/Resources/tree.js",
    "app/lib/widgets/shared/prelude.d.ts": "//packages/widget-script-kit:Targets/WidgetScriptSource/Sources/Resources/prelude.d.ts",
    "app/lib/widgets/shared/tree.d.ts": "//packages/widget-script-kit:Targets/WidgetScriptSource/Sources/Resources/tree.d.ts"
  },
  "exportedDirs": {
    "shell-sdk": "app/lib/shell-sdk"
  },
  "imports": {
    "~/": "./app/"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.window",
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "tasks": {
    "gen-contract": "test ! -f ../../../tools/contract-ts/emit.ts && echo 'gen-contract: emitter absent (in-graph inject); skipping' || (deno run --allow-read --allow-write ../../../tools/contract-ts/emit.ts ../../wuhu-core/Targets/SpaceContract/Tests/contract --out app/lib/contract.gen.ts && cp ../../wuhu-core/Targets/SpaceContract/Tests/contract/space-url-vectors.json app/lib/space-url.vectors.json && cp ../../wuhu-core/Targets/SpaceContract/Tests/contract/viewing-vectors.json app/lib/viewing.vectors.json)",
    "dev": "deno task gen-contract && deno run -A npm:@react-router/dev dev",
    "build": "deno run -A npm:@react-router/dev build",
    "typecheck": "deno task gen-contract && deno run -A npm:@react-router/dev typegen && deno run -A npm:typescript/tsc -p tsconfig.check.json",
    "fmt": "deno fmt --check .",
    "lint": "deno lint app",
    "test": "deno task gen-contract && deno test --sloppy-imports --allow-read --allow-env=NODE_ENV,WS_NO_BUFFER_UTIL --quiet app/lib app/sdk"
  }
}
