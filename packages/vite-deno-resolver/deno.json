{
  "name": "@wuhu/vite-deno-resolver",
  "version": "0.0.1",
  "owner": "shared",
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  },
  "exports": {
    ".": "./src/mod.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14",
    "@std/path": "jsr:@std/path@1.0.8"
  },
  "tasks": {
    "fmt": "deno fmt --check .",
    "lint": "deno lint src",
    "typecheck": "deno check src",
    "test": "deno test --allow-read src"
  }
}
